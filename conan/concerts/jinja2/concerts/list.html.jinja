{% extends "base.html.jinja" %}
{% block title %}CONAN — Negitachi{% endblock %}

{% block body %}
<div class="site-header">
  <div class="header-inner">
    <h1>CONAN <span>/ Gestion des concerts</span></h1>
    <p>Negitachi — outil interne</p>
    {% if request.user.is_authenticated %}
    <form class="user-bar" method="POST" action="{{ url('logout') }}">
      {{ csrf_input }}
      <span class="user-email">{{ request.user.email }}</span>
      <button type="submit" class="btn-logout">Déconnexion</button>
    </form>
    {% endif %}
  </div>
</div>
<div class="main">
  <div class="top-bar">
    <span class="section-title">{{ count }} concert{{ 's' if count > 1 else '' }}</span>
    <div class="top-bar-actions">
      <a class="btn-archives" href="{{ url('archives') }}">Archives</a>
      <button class="btn-new" onclick="document.getElementById('modal-choice').classList.add('open')">+ Nouveau concert</button>
    </div>
  </div>
  <div class="concert-list">
    {% if not cards %}
    <div class="empty-state">
      <div style="font-size:2rem">🎵</div>
      <p>Aucun concert actif pour l'instant.<br>Crées en un !</p>
    </div>
    {% else %}
    {% for c in cards %}
    <a class="concert-card{% if c.recap_warning %} recap-warning{% endif %}" href="{{ c.detail_url }}">
      <div class="concert-info">
        <div class="concert-name">{{ c.name or 'Concert sans nom' }}</div>
        {% set meta = [c.date, c.respo] | select | join(' · ') %}
        {% if meta %}<div class="concert-meta">{{ meta }}</div>{% endif %}
      </div>
      <div class="concert-prog">
        <span class="prog-pct">{{ c.progress }}%</span>
        <div class="prog-bar">
          <div class="prog-bar-fill" style="width:{{ c.progress }}%"></div>
        </div>
      </div>
      <div class="card-actions" onclick="event.stopPropagation()">
        <form method="POST" action="{{ c.archive_url }}">
          {{ csrf_input }}
          <button type="submit" class="btn-archive">Archiver</button>
        </form>
        <form method="POST" action="{{ c.delete_url }}">
          {{ csrf_input }}
          <button type="submit" class="btn-delete"
            onclick="return confirm('Supprimer « {{ c.name or 'ce concert' }} » ? Cette action est irréversible.')">
            🗑️
          </button>
        </form>
      </div>
    </a>
    {% endfor %}
    {% endif %}
  </div>
</div>

<div class="modal-overlay" id="modal-choice" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal">
    <h2>Nouveau concert</h2>
    <p class="modal-choice-hint">Quel type de concert ?</p>
    <div class="modal-choice-cards">
      <button type="button" class="modal-choice-card"
        onclick="document.getElementById('modal-choice').classList.remove('open');document.getElementById('modal-classic').classList.add('open')">
        <span class="modal-choice-title">Concert au format classique</span>
      </button>
      <button type="button" class="modal-choice-card"
        onclick="document.getElementById('modal-choice').classList.remove('open');document.getElementById('modal-orga').classList.add('open')">
        <span class="modal-choice-title">Concert orga full Negi</span>
      </button>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-cancel"
        onclick="document.getElementById('modal-choice').classList.remove('open')">Annuler</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-classic" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal">
    <h2>Nouveau concert classique</h2>
    <form method="POST" action="{{ url('create') }}">
      {{ csrf_input }}
      <div class="form-field">
        <label class="form-label" for="name">Nom du concert</label>
        <input class="form-input" type="text" id="name" name="name" placeholder="Ex : Jonetachi 2025" required
          autofocus>
      </div>
      <div class="form-field">
        <label class="form-label" for="date">Date</label>
        <input class="form-input" type="date" id="date" name="date">
      </div>
      <div class="form-field">
        <label class="form-label" for="respo">Respo Negi</label>
        <input class="form-input" type="text" id="respo" name="respo" placeholder="Prénom">
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel"
          onclick="document.getElementById('modal-classic').classList.remove('open')">Annuler</button>
        <button type="submit" class="btn-create">Créer →</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="modal-orga" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal">
    <h2>Nouveau concert orga full Negi</h2>
    <form method="POST" action="{{ url('o_create') }}">
      {{ csrf_input }}
      <div class="form-field">
        <label class="form-label" for="orga-name">Nom du concert</label>
        <input class="form-input" type="text" id="orga-name" name="name" placeholder="Ex : Jonetachi 2025" required
          autofocus>
      </div>
      <div class="form-field">
        <label class="form-label" for="orga-date">Date</label>
        <input class="form-input" type="date" id="orga-date" name="date">
      </div>
      <div class="form-field">
        <label class="form-label" for="orga-respo">Respo Negi</label>
        <input class="form-input" type="text" id="orga-respo" name="respo" placeholder="Prénom">
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel"
          onclick="document.getElementById('modal-orga').classList.remove('open')">Annuler</button>
        <button type="submit" class="btn-create">Créer →</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
